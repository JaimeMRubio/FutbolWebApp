38927>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38927>>>                Case Break
38928>>>
38928>>>            Case Else // must be nfUndefined
38928>>>
38928>>>        Case End
38928>>>
38928>>>        Send SetActionButtons
38929>>>
