37669>>>        Boolean bHasRecord
37669>>>        Handle hoDD
37669>>>
37669>>>        Get Server to hoDD
37670>>>        Get GetNavigateData to NavigateData
37671>>>        Get HasRecord of hoDD to bHasRecord
37672>>>
37672>>>        // let's hide all buttons and then Show the ones we want
37672>>>        WebSet pbRender of oEditBtn to False
37673>>>        WebSet pbRender of oSaveBtn to False
37674>>>        WebSet pbRender of oCancelChangesBtn to False
37675>>>        WebSet pbRender of oDeleteBtn to False
37676>>>
37676>>>        If (NavigateData.bReadOnly) Begin
37678>>>            WebSet pbRender of oEditBtn to True
37679>>>        End
37679>>>>
37679>>>        Else Begin
37680>>>            WebSet pbRender of oSaveBtn to True
37681>>>            WebSet pbRender of oCancelChangesBtn to True
37682>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37683>>>        End
