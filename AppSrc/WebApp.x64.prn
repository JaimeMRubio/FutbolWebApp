38886>>>    Procedure SetActionButtons
38889>>>        tWebNavigateData NavigateData
38889>>>        tWebNavigateData NavigateData
38889>>>        Boolean bHasRecord
38889>>>        Handle hoDD
38889>>>
38889>>>        Get Server to hoDD
38890>>>        Get GetNavigateData to NavigateData
38891>>>        Get HasRecord of hoDD to bHasRecord
38892>>>
38892>>>        // let's hide all buttons and then Show the ones we want
38892>>>        WebSet pbRender of oEditBtn to False
38893>>>        WebSet pbRender of oSaveBtn to False
38894>>>        WebSet pbRender of oCancelChangesBtn to False
38895>>>        WebSet pbRender of oDeleteBtn to False
38896>>>
38896>>>        If (NavigateData.bReadOnly) Begin
38898>>>            WebSet pbRender of oEditBtn to True
38899>>>        End
38899>>>>
38899>>>        Else Begin
38900>>>            WebSet pbRender of oSaveBtn to True
38901>>>            WebSet pbRender of oCancelChangesBtn to True
38902>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38903>>>        End
38903>>>>
38903>>>    End_Procedure
