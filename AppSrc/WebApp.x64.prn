38919>>>                // If from main, this is a propbably a main file Select to Zoom.
38919>>>                Case Break
38920>>>
38920>>>            Case (NavigateData.eNavigateType = nfFromParent)
38923>>>                // If from parent, this is a constrained drill down.
38923>>>                Case Break
38924>>>
