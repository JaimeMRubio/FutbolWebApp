38298>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38301>>>        Case Begin
38301>>>            Case (NavigateData.eNavigateType = nfFromMain)
38303>>>                // If from main, this is a propbably a main file Select to Zoom.
38303>>>                Case Break
38304>>>
38304>>>            Case (NavigateData.eNavigateType = nfFromParent)
38307>>>                // If from parent, this is a constrained drill down.
38307>>>                Case Break
38308>>>
38308>>>            Case (NavigateData.eNavigateType = nfFromChild)
38311>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38311>>>                Case Break
38312>>>
38312>>>            Case Else // must be nfUndefined
38312>>>
38312>>>        Case End
38312>>>
38312>>>        Send SetActionButtons
38313>>>
38313>>>    End_Procedure
38314>>>
38314>>>End_Object 
