38270>>>    Procedure SetActionButtons
38273>>>        tWebNavigateData NavigateData
38273>>>        tWebNavigateData NavigateData
38273>>>        Boolean bHasRecord
38273>>>        Handle hoDD
38273>>>
38273>>>        Get Server to hoDD
38274>>>        Get GetNavigateData to NavigateData
38275>>>        Get HasRecord of hoDD to bHasRecord
38276>>>
38276>>>        // let's hide all buttons and then Show the ones we want
38276>>>        WebSet pbRender of oEditBtn to False
38277>>>        WebSet pbRender of oSaveBtn to False
38278>>>        WebSet pbRender of oCancelChangesBtn to False
38279>>>        WebSet pbRender of oDeleteBtn to False
38280>>>
38280>>>        If (NavigateData.bReadOnly) Begin
38282>>>            WebSet pbRender of oEditBtn to True
38283>>>        End
38283>>>>
38283>>>        Else Begin
38284>>>            WebSet pbRender of oSaveBtn to True
38285>>>            WebSet pbRender of oCancelChangesBtn to True
38286>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38287>>>        End
38287>>>>
38287>>>    End_Procedure
38288>>>
