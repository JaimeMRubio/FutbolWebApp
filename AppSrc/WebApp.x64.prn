38827>>>        Get HasRecord of hoDD to bHasRecord
38828>>>
38828>>>        // let's hide all buttons and then Show the ones we want
38828>>>        WebSet pbRender of oEditBtn to False
38829>>>        WebSet pbRender of oSaveBtn to False
38830>>>        WebSet pbRender of oCancelChangesBtn to False
38831>>>        WebSet pbRender of oDeleteBtn to False
38832>>>
38832>>>        If (NavigateData.bReadOnly) Begin
38834>>>            WebSet pbRender of oEditBtn to True
38835>>>        End
38835>>>>
38835>>>        Else Begin
38836>>>            WebSet pbRender of oSaveBtn to True
38837>>>            WebSet pbRender of oCancelChangesBtn to True
38838>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38839>>>        End
38839>>>>
38839>>>    End_Procedure
